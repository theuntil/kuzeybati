# =============================================================
#  KUZEYBATI HABER — SİTE ORTAM DEĞİŞKENLERİ
#
#  ⚠️ Burada SUPABASE_SERVICE_ROLE_KEY YOKTUR ve OLMAMALIDIR.
#     Site sadece anon anahtarla, RLS altında okur.
# =============================================================

NEXT_PUBLIC_SITE_URL=https://kuzeybatihaber.com.tr

# ---- Supabase (anon = herkese açık, RLS korur) --------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Medya CDN (bot'un CDN_BASE değeriyle AYNI olmalı) ------
NEXT_PUBLIC_CDN_BASE=https://medya.kuzeybatihaber.com.tr

# ---- ISR yeniden doğrulama (bot bu adrese POST atar) --------
REVALIDATE_SECRET=

# ---- Dış servisler (hepsi anahtarsız/ücretsiz) --------------
# Namaz vakti: Aladhan, method 13 = Diyanet İşleri Başkanlığı
PRAYER_METHOD=13
# Hava durumu: Open-Meteo (anahtar gerekmez)
# Borsa: borsa-api paketi (Yahoo Finance üzerinden, gecikmeli)

# ---- Skor API (Trendyol Süper Lig, TFF verisi) --------------
# Anahtar SUNUCUDA kalır; tarayıcıya inmez.
# Yoksa skor bölümleri hiç gösterilmez.
SKOR_API_URL=https://skor.rovand.cloud
SKOR_API_KEY=

# ---- Nöbetçi eczane (api.nobetecza.com) ---------------------
# Anahtar SUNUCUDA kalır; tarayıcıya inmez.
# Yoksa eczane hizmeti hiç gösterilmez.
ECZANE_API_URL=https://api.nobetecza.com
ECZANE_API_KEY=

# ---- Mail servisi ---------------------------------------------
# ZORUNLU: e-posta doğrulama ve şifre sıfırlama bunsuz çalışmaz.
# Anahtar mail servisindeki MAIL_API_KEY ile AYNI olmalı.
MAIL_API_URL=https://mail.kuzeybatihaber.cloud
MAIL_API_KEY=

# ---- Cloudflare R2 -------------------------------------------
# ⚠ SUNUCUDA KALIR. NEXT_PUBLIC_ öneki ASLA verme — verirsen
#   imaja gömülür ve herkes bucket'a yazabilir.
#
# Supabase Storage artık KULLANILMIYOR. Avatar, kitaplık, logo,
# yazar görselleri — hepsi bot medyasıyla aynı R2 bucket'ında.
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=haber-medya
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
